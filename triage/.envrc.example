# Copy to triage/.envrc (untracked) and fill in; direnv loads it automatically.
# Read-only credentials for the pyro-annotator API (annotator.pyronear.org).
# triage only ever issues GETs (plus the login POST that mints the token).
export ANNOTATOR_API_URL=https://annotator.pyronear.org
export ANNOTATOR_API_LOGIN=changeme
export ANNOTATOR_API_PASSWORD=changeme
